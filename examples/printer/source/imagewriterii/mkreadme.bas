10  REM  WRITE README INTO IMAGEWRITERII
20  D$ =  CHR$ (4)
30  F$ = "/SCREEN.TO.PRINT/IMAGEWRITERII/README"
40  PRINT D$;"OPEN ";F$
50  PRINT D$;"WRITE ";F$
60  READ L$: IF L$ = "*EOF*" THEN 100
70  PRINT L$
80  GOTO 60
100  PRINT D$;"CLOSE"
110  PRINT "README WRITTEN"
120  END
200  DATA "**  SCREEN TO PRINT - IMAGEWRITER II",""
210  DATA "These programs dump the Apple //e"
220  DATA "graphics screen to an ImageWriter II"
230  DATA "over the Super Serial Card in slot 2."
240  DATA "Color or black-and-white.",""
250  DATA "FILES IN THIS FOLDER","--------------------"
260  DATA "LORES.PLOT   draw 40-col lo-res test"
270  DATA "LORES.BW     print lo-res  (black)"
280  DATA "LORES.COLOR  print lo-res  (color)"
290  DATA "DLORES.PLOT  draw 80-col dbl lo-res"
300  DATA "DLORES.BW    print dbl lo-res (black)"
310  DATA "DLORES.COLOR print dbl lo-res (color)"
320  DATA "VIEW         show this README",""
330  DATA "SET UP","-----"
340  DATA "1. Super Serial Card in slot 2."
350  DATA "2. ImageWriter II on-line."
360  DATA "3. Color ribbon + COLOR mode for the"
370  DATA "   color programs.",""
380  DATA "PAGE SELECT (location 9)","------------------------"
390  DATA "POKE 9,0  = graphics page 1"
400  DATA "POKE 9,1  = graphics page 2",""
410  DATA "DRAW THEN PRINT","---------------"
420  DATA "Run a PLOT to draw a screen then run"
430  DATA "the matching print program to dump it.",""
440  DATA "Lo-res page 1 example:"
450  DATA "] BLOAD LORES.PLOT,A$6000"
460  DATA "] POKE 9,0 : CALL 24576"
470  DATA "] BLOAD LORES.COLOR,A$6000"
480  DATA "] CALL 24576",""
490  DATA "Double lo-res page 1 example:"
500  DATA "] BLOAD DLORES.PLOT,A$6000"
510  DATA "] POKE 9,0 : CALL 24576"
520  DATA "] BLOAD DLORES.COLOR,A$6000"
530  DATA "] CALL 24576",""
540  DATA "NOTES","-----"
550  DATA "Code is relocatable - any A$addr OK."
560  DATA "Dbl lo-res shows on screen only from"
570  DATA "page 1.  A dump can take a minute as"
580  DATA "the printer paces the output."
590  DATA "BW programs also suit an ImageWriter I.",""
600  DATA "Happy printing!","*EOF*"
