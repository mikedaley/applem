10  REM  WRITE README INTO EPSON.FX.80
20  D$ =  CHR$ (4)
30  F$ = "/SCREEN.TO.PRINT/EPSON/FX.80/README"
40  PRINT D$;"OPEN ";F$
50  PRINT D$;"WRITE ";F$
60  READ L$: IF L$ = "*EOF*" THEN 100
70  PRINT L$
80  GOTO 60
100  PRINT D$;"CLOSE"
110  PRINT "README WRITTEN"
120  END
200  DATA "  SCREEN TO PRINT - EPSON FX-80",""
210  DATA "These programs dump the Apple //e"
220  DATA "graphics screen to an Epson FX-80"
230  DATA "over the Apple Parallel Interface"
240  DATA "Card in slot 1."
250  DATA "Black-and-white only - the FX-80 has"
260  DATA "no colour ribbon.  For colour use an"
270  DATA "ImageWriter II.",""
280  DATA "The FX-80 speaks Epson ESC/P, so the"
290  DATA "dumps use ESC * for graphics and ESC A"
300  DATA "for line spacing - a different dialect"
310  DATA "to the ImageWriter / DMP (C. Itoh) but"
320  DATA "it prints the same picture.",""
330  DATA "FILES IN THIS FOLDER"
340  DATA "LR.PLOT    draw 40-col lo-res test"
350  DATA "LR.BW      print lo-res  (greys)"
360  DATA "DLR.PLOT   draw 80-col dbl lo-res"
370  DATA "DLR.BW     print dbl lo-res (greys)"
380  DATA "HGR.ART    draw hi-res test picture"
390  DATA "HGR.BW     print hi-res  (greys)"
400  DATA "DHGR.ART   draw dbl hi-res picture"
410  DATA "DHGR.BW    print dbl hi-res (greys)"
420  DATA "VIEW       show this README",""
430  DATA "SET UP","------"
440  DATA "1. Apple Parallel Interface Card in"
450  DATA "   slot 1."
460  DATA "2. Epson FX-80 on-line.",""
470  DATA "PAGE SELECT (location 9)"
480  DATA "POKE 9,0  = graphics page 1"
490  DATA "POKE 9,1  = graphics page 2",""
500  DATA "DRAW THEN PRINT"
510  DATA "Run a PLOT/ART to draw a screen then"
520  DATA "run the matching BW program to dump it.",""
530  DATA "Lo-res page 1 example:"
540  DATA "] BLOAD LR.PLOT,A$6000"
550  DATA "] POKE 9,0 : CALL 24576"
560  DATA "] BLOAD LR.BW,A$6000"
570  DATA "] CALL 24576",""
580  DATA "HGR/DHGR CONTROLS (before CALL)"
590  DATA "POKE 24579,n  width 0=7.8 1=7.0"
600  DATA "              2=5.8 3=3.5 (4:3)"
610  DATA "POKE 24580,1  double height (tall)"
620  DATA "POKE 24581,p  page 0=one 1=two"
630  DATA "POKE 24582,s  parallel slot (def 1)",""
640  DATA "NOTES","-----"
650  DATA "Code is relocatable - any A$addr OK."
660  DATA "Every colour prints as its own grey"
670  DATA "so the design reads in black & white."
680  DATA "Width mode 3 (240 dpi) is quad density:"
690  DATA "the FX-80 cannot fire adjacent dots so"
700  DATA "solids thin to grey - it is the narrow"
710  DATA "4:3 aspect mode."
720  DATA "A dump can take a minute as the"
730  DATA "printer paces the output."
740  DATA "Happy printing!","*EOF*"
